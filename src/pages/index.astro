---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../lib/base";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const cases = (await getCollection("portfolio")).sort((a, b) => a.data.order - b.data.order).slice(0, 2);
---

<BaseLayout title="首頁">
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-20 grid gap-12 md:grid-cols-2 md:items-center">
    <div>
      <h1 class="text-3xl md:text-4xl font-bold leading-snug text-ink-700">
        AI 氾濫的年代，你是否感到焦慮？
      </h1>
      <p class="mt-6 text-lg text-ink-500 leading-relaxed">
        在數位轉型的路上，你需要的不一定是先進的 AI 工具；而是一個站在你身邊，陪你解決問題的夥伴。
      </p>
      <div class="mt-8 flex gap-4">
        <a
          href={withBase("/contact")}
          class="inline-block rounded-md bg-primary-500 px-6 py-3 text-white font-semibold hover:bg-primary-600 transition-colors"
        >
          聯絡我們
        </a>
        <a
          href={withBase("/services")}
          class="inline-block rounded-md border border-primary-300 px-6 py-3 text-primary-500 font-semibold hover:bg-primary-50 transition-colors"
        >
          看服務項目
        </a>
      </div>
    </div>
    <div class="justify-self-center">
      <img
        src={withBase("/images/profile/hero-placeholder.svg")}
        alt="阿任形象照（預留位）"
        class="rounded-lg shadow-sm w-full max-w-xs"
      />
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16 border-t border-primary-100">
    <h2 class="text-2xl font-bold text-ink-700 mb-8">服務亮點</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {services.map((service) => (
        <a
          href={withBase(`/services/${service.id}`)}
          class="block rounded-lg border border-primary-100 p-6 hover:border-primary-500 hover:shadow-sm transition"
        >
          <h3 class="font-semibold text-ink-700 mb-2">{service.data.title}</h3>
          <p class="text-sm text-ink-500 leading-relaxed">{service.data.summary}</p>
        </a>
      ))}
    </div>
    <a href={withBase("/services")} class="mt-8 inline-block text-primary-500 font-semibold hover:underline">
      看全部 7 項服務 →
    </a>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16 border-t border-primary-100">
    <h2 class="text-2xl font-bold text-ink-700 mb-8">精選案例</h2>
    <div class="grid gap-6 md:grid-cols-2">
      {cases.map((item) => (
        <a
          href={withBase("/portfolio")}
          class="block rounded-lg border border-primary-100 p-6 hover:border-primary-500 hover:shadow-sm transition"
        >
          <p class="text-xs text-primary-500 font-semibold mb-1">{item.data.client}</p>
          <h3 class="font-semibold text-ink-700 mb-2">{item.data.title}</h3>
          <p class="text-sm text-ink-500 leading-relaxed">{item.data.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16 border-t border-primary-100 text-center">
    <h2 class="text-2xl font-bold text-ink-700 mb-4">先診斷，再開藥</h2>
    <p class="max-w-2xl mx-auto text-ink-500 leading-relaxed">
      不預設答案、不推銷工具。第一個問題永遠是——你現在最痛的地方在哪裡？能用 Excel
      公式解決的問題，就不必強用 AI。
    </p>
    <a
      href={withBase("/contact")}
      class="mt-8 inline-block rounded-md bg-primary-500 px-6 py-3 text-white font-semibold hover:bg-primary-600 transition-colors"
    >
      跟阿任聊聊
    </a>
  </section>
</BaseLayout>
