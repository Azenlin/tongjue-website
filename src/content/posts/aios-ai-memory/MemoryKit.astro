---
/** 床頭的 5 樣東西：淺紅底、帶線條 icon 的卡片；每張標出對應第幾層，「記憶筆記」用品牌紅強調 */
const items = [
  { n: '行為準則', f: 'CLAUDE.md 或 AGENTS.md', d: '規矩是什麼，什麼可以自己決定、什麼要先問你', l: '第一層｜人機協作', icon: 'rule' },
  { n: '記憶筆記', f: 'knowledge.md', d: '你是誰、客戶是誰、以前發生過什麼、做過哪些決定', l: '第二層｜記憶庫', icon: 'note', key: true },
  { n: '操作手冊', f: 'skill.md', d: '常做的工作，一步一步該怎麼做', l: '第三層｜工作流程', icon: 'book' },
  { n: '每日例行清單', f: 'index.md', d: '每天開始、結束時固定要做的事', l: '第四層｜自動化', icon: 'list' },
  { n: '鑰匙', f: 'API、MCP、connector', d: '能自己打開 email、行事曆、公司系統，不必每份資料都等你遞給他', l: '第五層｜接上外部系統', icon: 'key' },
];
const paths: Record<string, string> = {
  rule: 'M6 3h9l3 3v15H6z M9 9h6 M9 13h6 M9 17h4',
  note: 'M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z M5 17a3 3 0 0 1 3-3h11 M9 8h6',
  book: 'M4 5c3-1 5-1 8 1v14c-3-2-5-2-8-1z M20 5c-3-1-5-1-8 1v14c3-2 5-2 8-1z',
  list: 'M9 6h11 M9 12h11 M9 18h11 M4 6l1 1 2-2 M4 12l1 1 2-2 M4 18l1 1 2-2',
  key: 'M14 10a4 4 0 1 0-1.2 2.8L20 20 M17 17l2-2 M15 15l1.5-1.5',
};
---
<ol class="mk" aria-label="替失憶的超人準備的 5 樣東西">
  {items.map((x, i) => (
    <li class={x.key ? 'mk-key' : ''}>
      <svg class="mk-ic" viewBox="0 0 24 24" aria-hidden="true"><path d={paths[x.icon]} /></svg>
      <p class="mk-n"><span class="mk-i">{i + 1}</span>{x.n}</p>
      <p class="mk-f">{x.f}</p>
      <p class="mk-d">{x.d}</p>
      <p class="mk-l">{x.l}</p>
    </li>
  ))}
</ol>

<style>
.mk{list-style:none;margin:36px 0 !important;padding:0 !important;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
.mk li{margin:0 !important;display:flex;flex-direction:column;padding:18px 14px 14px;border-radius:12px;background:#f7f3f2}
.mk li::marker{content:none}
.mk-ic{width:30px;height:30px;fill:none;stroke:#5a5a5a;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.mk-n{margin:12px 0 0 !important;font-family:'Noto Serif TC',serif;font-weight:700;font-size:18px;line-height:26px;color:#1a1a1a}
.mk-i{margin-right:6px;font-family:'Noto Sans TC',sans-serif;font-size:13px;color:#8d1d22}
.mk-f{margin:2px 0 0 !important;font-size:12px;line-height:18px;color:#888888;word-break:break-word}
.mk-d{margin:10px 0 0 !important;flex:1;font-size:14px;line-height:22px;color:#333333}
.mk-l{margin:12px 0 0 !important;padding-top:10px;border-top:1px solid #e6dcda;font-size:12px;line-height:18px;font-weight:600;color:#8d1d22}
.mk-key{background:#8d1d22 !important}
.mk-key .mk-ic{stroke:#ffffff}
.mk-key .mk-n,.mk-key .mk-d,.mk-key .mk-i{color:#ffffff}
.mk-key .mk-f{color:#e9c4c6}
.mk-key .mk-l{color:#ffffff;border-top-color:rgba(255,255,255,.3)}
@media (max-width:760px){
.mk{grid-template-columns:minmax(0,1fr);gap:8px}
.mk li{display:grid;grid-template-columns:36px minmax(0,1fr);column-gap:12px;padding:14px 16px}
.mk-ic{grid-row:1 / 5;width:28px;height:28px;margin-top:2px}
.mk-n{margin:0 !important}
.mk-d{margin-top:4px !important}
.mk-l{margin-top:8px !important;padding-top:8px}
}
</style>
