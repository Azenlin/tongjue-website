---
/** 一句話背後：捲到畫面時自動播放——使用者提問 → AI「讓我看一下過去是怎麼做的…」→ 停 1 秒列出所有任務 → 逐項執行打勾 */
const tasks = [
  '找到網站程式的資料夾，並同步最新版',
  '版面先改設計稿，再匯入網站',
  '重新建置整個網站，逐頁檢查有沒有壞掉',
  '截圖檢查手機版和電腦版',
  '確認沒問題後上線，並同步備份到 Google Drive',
  '改到文章文字，先改知識庫裡的定稿',
];
---
<figure class="ol">
  <div class="ol-chat">
    <p class="ol-step ol-me" style="--d:0.2s">幫我把官網首頁的照片，在手機上改成圓形。</p>
    <p class="ol-step ol-ai" style="--d:1s">讓我看一下過去是怎麼做的…</p>
    <div class="ol-step ol-tasks" style="--d:2s">
      <ol>
        {tasks.map((t, i) => (
          <li style={`--i:${i}`}><span class="ol-ck" aria-hidden="true"></span><span class="ol-tx">{t}</span></li>
        ))}
      </ol>
    </div>
    <p class="ol-step ol-fin" style={`--d:${2.8 + tasks.length * 0.9 + 0.2}s`}>完成，大約花了 4 分 30 秒。</p>
  </div>
  <figcaption>你說一句，其他的 AI 自己從記憶裡補齊。<button type="button" class="ol-replay">重播</button></figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.ol').forEach((el) => {
    el.classList.add('ol-ready');
    const play = () => {
      el.classList.remove('ol-play');
      void el.offsetWidth;
      el.classList.add('ol-play');
    };
    el.querySelector('.ol-replay')!.addEventListener('click', play);
    if (!('IntersectionObserver' in window)) return play();
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { play(); io.disconnect(); }
    }, { threshold: 0.4 });
    io.observe(el);
  });
</script>

<style>
.ol{margin:40px 0 !important}
.ol-chat{display:flex;flex-direction:column;gap:12px;padding:24px;border-radius:16px;background:#eef0f2}
.ol-chat p{margin:0 !important}
.ol-me{align-self:flex-end;max-width:80%;padding:12px 18px;border-radius:18px 18px 4px 18px;background:#8d1d22;color:#ffffff;font-size:17px;line-height:26px}
.ol-ai{align-self:flex-start;padding:10px 16px;border-radius:18px 18px 18px 4px;background:#ffffff;color:#1a1a1a;font-size:15px;line-height:22px;font-weight:600}
.ol-tasks{align-self:flex-start;max-width:92%;padding:12px 16px;border-radius:4px 14px 14px 14px;background:#ffffff}
.ol-tasks ol{list-style:none;margin:0 !important;padding:0 !important;display:flex;flex-direction:column;gap:8px}
.ol-tasks li{margin:0 !important;display:flex;align-items:flex-start;gap:10px;font-size:15px;line-height:24px;color:#1a1a1a}
.ol-tasks li::marker{content:none}
.ol-ck{position:relative;flex:none;width:20px;height:20px;margin-top:2px;border:1.5px solid #8d1d22;border-radius:50%;background:#8d1d22}
.ol-ck::after{content:'';position:absolute;left:6px;top:2px;width:5px;height:9px;border:solid #ffffff;border-width:0 2px 2px 0;transform:rotate(45deg)}
.ol-fin{align-self:flex-start;padding:10px 16px;border-radius:4px 14px 14px 14px;background:#ffffff;color:#8d1d22;font-size:15px;line-height:22px;font-weight:600}
.ol-replay{display:none;margin-left:12px;padding:0 2px;border:0;border-bottom:1px solid currentColor;background:transparent;color:#8d1d22;font:inherit;font-size:14px;cursor:pointer}
.ol-replay:focus-visible{outline:2px dashed #8d1d22;outline-offset:2px}

@media (prefers-reduced-motion:no-preference){
  .ol-ready .ol-step{opacity:0}
  .ol-play .ol-step{animation:olIn .4s ease forwards;animation-delay:var(--d)}
  .ol-ready .ol-ck{border-color:#bdbdbd;background:transparent}
  .ol-ready .ol-ck::after{opacity:0}
  .ol-ready .ol-tx{color:#8a8a8a}
  .ol-play .ol-ck{animation:olCk .8s ease forwards;animation-delay:calc(2.8s + var(--i) * .9s)}
  .ol-play .ol-ck::after{animation:olTick .8s ease forwards;animation-delay:calc(2.8s + var(--i) * .9s)}
  .ol-play .ol-tx{animation:olTx .8s ease forwards;animation-delay:calc(2.8s + var(--i) * .9s)}
  .ol-ready .ol-replay{display:inline;opacity:0;pointer-events:none}
  .ol-play .ol-replay{animation:olShow .4s ease forwards;animation-delay:9.8s}
}
@keyframes olIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
@keyframes olCk{0%{border-color:#bdbdbd;background:transparent;box-shadow:0 0 0 0 rgba(141,29,34,0)}40%{border-color:#8d1d22;background:transparent;box-shadow:0 0 0 4px rgba(141,29,34,.18)}100%{border-color:#8d1d22;background:#8d1d22;box-shadow:0 0 0 0 rgba(141,29,34,0)}}
@keyframes olTick{0%,55%{opacity:0}100%{opacity:1}}
@keyframes olTx{0%{color:#8a8a8a}40%,100%{color:#1a1a1a}}
@keyframes olShow{to{opacity:1;pointer-events:auto}}
@media (max-width:760px){.ol-chat{padding:16px 12px}.ol-me{max-width:90%;font-size:16px}.ol-tasks{max-width:100%}.ol-tasks li{font-size:14px;line-height:22px}}
</style>
