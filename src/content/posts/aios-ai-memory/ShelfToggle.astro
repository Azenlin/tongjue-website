---
/** 倉庫／圖書館切換：開一個資料夾給 AI vs 可持續運轉的知識庫；切換時上方圖像與下方 6 列對照一起換 */
const files = [
  { n: '會議記錄_最終版.docx', x: 4, y: 10, r: -8 },
  { n: '報價單 (2).pdf', x: 52, y: 4, r: 6 },
  { n: '截圖 2026-08-03.png', x: 28, y: 30, r: -3 },
  { n: '客戶來信.eml', x: 66, y: 34, r: 10 },
  { n: '會議記錄_最終版_v3.docx', x: 6, y: 56, r: 5 },
  { n: '簡報_舊.pptx', x: 48, y: 60, r: -11 },
  { n: 'IMG_4821.jpg', x: 74, y: 70, r: 4 },
  { n: '合約掃描.pdf', x: 22, y: 78, r: -6 },
];
const shelves = [
  { h: '會議', b: ['週會 9/23', '客戶提案'] },
  { h: '閱讀', b: ['卡片盒筆記', '原子習慣'] },
  { h: '知識', b: ['30 秒找回', 'Skill 化'] },
  { h: '產出', b: ['官網文章', '課程講義'] },
  { h: '人', b: ['客戶 A', '夥伴 B'] },
];
const rows = [
  { k: '資料的樣子', a: '原始檔案原封不動：PDF、Word、截圖', b: '整理成 AI 讀得懂的筆記，每則都有摘要' },
  { k: '找資料', a: '檔案一多，AI 往往只挑幾段字面相近的片段來讀，前後文被切斷，容易抓不到重點', b: 'AI 先看目錄和摘要，決定該讀哪幾則，再把整則筆記讀完' },
  { k: '規矩', a: '沒有，AI 每次自己猜', b: '有一份準則，說好什麼能做、什麼要問' },
  { k: '範圍', a: '只在這個專案裡有用', b: '跨專案共用，整理一次，處處可用' },
  { k: '會不會長大', a: '你放多少就是多少', b: '每次工作後都會新增、萃取、連結，連糾正過的事都記得' },
  { k: '時間久了', a: '越堆越亂，最後沒人敢打開', b: '定期健檢，越用越好用' },
];
---
<figure class="sh">
  <div class="sh-tabs" role="group" aria-label="切換比較對象">
    <button type="button" class="sh-tab" data-v="wh" aria-pressed="true"><b>倉庫</b><span>開一個資料夾給 AI</span></button>
    <button type="button" class="sh-tab" data-v="lib" aria-pressed="false"><b>圖書館</b><span>可持續運轉的知識庫</span></button>
  </div>

  <div class="sh-stage">
    <div class="sh-wh" aria-hidden="true">
      {files.map((f) => <span class="sh-file" style={`left:${f.x}%;top:${f.y}%;--r:${f.r}deg`}>{f.n}</span>)}
    </div>
    <div class="sh-lib" aria-hidden="true">
      {shelves.map((s) => (
        <div class="sh-shelf">
          <div class="sh-books">{s.b.map((t, i) => <span class={i === 0 ? 'sh-book sh-book-1' : 'sh-book'}>{t}</span>)}</div>
          <p class="sh-label">{s.h}</p>
        </div>
      ))}
    </div>
    <p class="sh-say sh-say-wh">東西都在，但每次都得從頭翻一遍</p>
    <p class="sh-say sh-say-lib">每本都有一行摘要，AI 先看摘要再決定打開哪幾本</p>
  </div>

  <dl class="sh-rows" aria-live="polite">
    {rows.map((r) => (
      <div class="sh-row">
        <dt>{r.k}</dt>
        <dd><span class="sh-a">{r.a}</span><span class="sh-b">{r.b}</span></dd>
      </div>
    ))}
  </dl>
  <figcaption>切換看看：同一批資料，堆在倉庫裡和排進圖書館，AI 讀起來差很多。</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.sh').forEach((el) => {
    const tabs = el.querySelectorAll<HTMLButtonElement>('.sh-tab');
    tabs.forEach((t) => t.addEventListener('click', () => {
      const lib = t.dataset.v === 'lib';
      el.classList.toggle('sh-is-lib', lib);
      tabs.forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
    }));
  });
</script>

<style>
.sh{margin:40px 0 !important;padding:24px 32px;border-radius:12px;background:#f5f2ec}
.sh-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px;padding:4px;border-radius:10px;background:#e6e1d8}
.sh-tab{display:flex;flex-direction:column;align-items:center;gap:2px;padding:10px 8px;border:0;border-radius:7px;background:transparent;color:#5a5a5a;font:inherit;cursor:pointer;transition:background .2s,color .2s,box-shadow .2s}
.sh-tab b{font-family:'Noto Serif TC',serif;font-size:18px;line-height:26px;font-weight:700}
.sh-tab span{font-size:13px;line-height:20px}
.sh-tab[aria-pressed='true']{background:#ffffff;color:#1a1a1a;box-shadow:0 1px 4px rgba(0,0,0,.12)}
.sh-is-lib .sh-tab[aria-pressed='true'] b{color:#8d1d22}
.sh-tab:focus-visible{outline:2px dashed #8d1d22;outline-offset:2px}

.sh-stage{position:relative;height:250px;margin-top:20px}
.sh-wh,.sh-lib{position:absolute;inset:0 0 40px;transition:opacity .35s ease,transform .35s ease}
.sh-wh{border:2px dashed #c9c1b3;border-radius:10px;background:#ece6dc}
.sh-file{position:absolute;padding:6px 10px;border:1px solid #d6d0c6;border-radius:4px;background:#ffffff;color:#5a5a5a;font-size:13px;line-height:18px;white-space:nowrap;box-shadow:0 2px 4px rgba(0,0,0,.08);transform:rotate(var(--r))}
.sh-lib{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;opacity:0;transform:translateY(8px);pointer-events:none}
.sh-shelf{display:flex;flex-direction:column;justify-content:flex-end}
.sh-books{display:flex;align-items:flex-end;justify-content:center;gap:6px;padding:0 4px;border-bottom:6px solid #6b4f3a}
.sh-book{display:flex;align-items:center;justify-content:center;width:34px;height:150px;padding:8px 0;border-radius:3px 3px 0 0;background:#ffffff;border:1px solid #d6d0c6;border-bottom:0;color:#333333;font-size:13px;line-height:15px;writing-mode:vertical-rl;letter-spacing:1px}
.sh-book-1{height:170px;background:#8d1d22;border-color:#8d1d22;color:#ffffff}
.sh-label{margin:8px 0 0 !important;text-align:center;font-family:'Noto Serif TC',serif;font-weight:700;font-size:15px;line-height:22px;color:#1a1a1a}
.sh-say{position:absolute;left:0;right:0;bottom:0;margin:0 !important;text-align:center;font-size:15px;line-height:24px;color:#5a5a5a;transition:opacity .35s}
.sh-say-lib{opacity:0;color:#8d1d22}
.sh-is-lib .sh-wh{opacity:0;transform:translateY(-8px);pointer-events:none}
.sh-is-lib .sh-lib{opacity:1;transform:none}
.sh-is-lib .sh-say-wh{opacity:0}
.sh-is-lib .sh-say-lib{opacity:1}

.sh-rows{margin:20px 0 0 !important;padding:0;border-top:1px solid #ddd6ca}
.sh-row{display:grid;grid-template-columns:110px minmax(0,1fr);gap:16px;padding:12px 0;border-bottom:1px solid #ddd6ca}
.sh-row dt{font-weight:600;font-size:15px;line-height:26px;color:#1a1a1a}
.sh-row dd{margin:0 !important;font-size:16px;line-height:26px;color:#333333}
.sh-b{display:none}
.sh-is-lib .sh-a{display:none}
.sh-is-lib .sh-b{display:inline;animation:shIn .35s ease}
.sh-a{animation:shIn .35s ease}
@keyframes shIn{0%{opacity:0}100%{opacity:1}}
.sh figcaption{margin-top:16px !important}

@media (max-width:760px){
.sh{padding:20px 16px}
.sh-tab b{font-size:16px;line-height:24px}
.sh-tab span{font-size:12px;line-height:18px}
.sh-stage{height:230px}
.sh-file{font-size:11px;line-height:16px;padding:4px 7px}
.sh-lib{gap:4px}
.sh-books{gap:3px;padding:0 2px}
.sh-book{width:24px;height:130px;font-size:11px;line-height:13px;letter-spacing:0}
.sh-book-1{height:148px}
.sh-label{font-size:14px}
.sh-row{grid-template-columns:minmax(0,1fr);gap:2px;padding:10px 0}
.sh-row dt{font-size:14px;line-height:22px;color:#5a5a5a}
}
@media (prefers-reduced-motion:reduce){.sh-wh,.sh-lib,.sh-say{transition:none}.sh-a,.sh-is-lib .sh-b{animation:none}}
</style>
