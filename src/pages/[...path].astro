---
/**
 * 依 src/design/pages.json 產生每一頁：網址、標題、描述都在那份設定裡，
 * 版面/樣式/程式分別讀 src/design/<Name>.body.html / .css / .logic.js。
 */
import DesignPage from '../layouts/DesignPage.astro';
import pages from '../design/pages.json';
// 暫時下架、只當版型用的頁面（例如 PillarAI 是文章頁版型，但「中小企業 AI 導入指南」本身先不上線）
import hidden from '../lib/hidden-pages.json';
import { getPosts, blogLogic, latestCards, coverCss } from '../lib/posts';

export function getStaticPaths() {
  return Object.entries(pages).filter(([name]) => !hidden.includes(name)).map(([name, p]) => ({
    params: { path: p.route === '/' ? undefined : p.route.replace(/^\/|\/$/g, '') },
    props: { name },
  }));
}

const bodies = import.meta.glob('../design/*.body.html', { query: '?raw', import: 'default', eager: true });
const styles = import.meta.glob('../design/*.css', { query: '?raw', import: 'default', eager: true });
const logics = import.meta.glob('../design/*.logic.js', { query: '?raw', import: 'default', eager: true });

const { name } = Astro.props;
const p = pages[name as keyof typeof pages];

// 文章列表與「最新觀點」卡片換成 src/content/posts/ 的真實文章（見 src/lib/posts.ts）
let body = bodies[`../design/${name}.body.html`] as string;
let css = styles[`../design/${name}.css`] as string;
let logic = logics[`../design/${name}.logic.js`] as string;
if (name === 'Blog' || name === 'Main' || name === 'Yujen') {
  const posts = await getPosts();
  css += '\n' + coverCss(posts);
  if (name === 'Blog') logic = blogLogic(logic, posts);
  else body = latestCards(body, posts);
}
---
<DesignPage
  name={name}
  title={p.title}
  description={p.description}
  route={p.route}
  dynamic={p.dynamic}
  body={body}
  css={css}
  logic={logic}
/>
