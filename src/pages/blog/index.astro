---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../lib/base";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="銅爵觀點" description="銅爵科技顧問的部落格，分享製程、AI 導入、能源與淨零策略的觀察。">
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-bold text-ink-700 mb-10">銅爵觀點</h1>
    <div class="space-y-8">
      {posts.map((post) => (
        <a href={withBase(`/blog/${post.id}`)} class="block group">
          <p class="text-xs text-ink-500/70 mb-1">
            {post.data.pubDate.toLocaleDateString("zh-TW", { year: "numeric", month: "long", day: "numeric" })}
          </p>
          <h2 class="text-xl font-semibold text-ink-700 group-hover:text-primary-500 transition-colors">
            {post.data.title}
          </h2>
          <p class="text-sm text-ink-500 mt-1">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
