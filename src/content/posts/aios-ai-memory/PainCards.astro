---
/** 你每天用 AI 時會遇到的 4 個狀況：白底、無外框、左側品牌紅粗線的純文字卡 */
const items = [
  { h: '專案散落在各個 AI 平台', d: '簡報在 Gemini Notebook、生成的圖片在 ChatGPT、文件在 Claude。每個平台只記得自己那一塊，沒有一個 AI 看得到你工作的全貌。ChatGPT 雖然有「專案」功能，但也只記得專案內的事；像你的寫作習慣、各個專案和人之間的關係，這些跨專案的記憶，沒有地方可以放。' },
  { h: '你成了資訊的搬運工', d: '工作資料散落在 email、LINE 群組、公司共用槽、自己的 Google Drive、公司的 ERP 系統裡。請 AI 做事之前，你得先把資料一份一份找出來、搬給 AI，它才能理解。更麻煩的是，這只對「這一次」有效：離開這次的對話或專案，它可能又忘了，下次你還得再搬一次。' },
  { h: 'AI 記錯重點', d: '現在的 AI 其實有記憶，但你沒辦法窺見他的記憶庫；你不確定它記了什麼、忘了什麼。它可能記得你早晨有喝美式咖啡的習慣，卻不記得你手上某個案子 delay 的前因後果。' },
  { h: '工具越來越多，越來越焦慮', d: '每個月都有新的 AI 工具，不知道該用哪一個，又擔心自己跟不上同事。' },
];
---
<ul class="pc">
  {items.map((x) => (
    <li><p class="pc-h">{x.h}</p><p class="pc-d">{x.d}</p></li>
  ))}
</ul>

<style>
.pc{list-style:none;margin:36px 0 !important;padding:0 !important;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 32px}
.pc li{margin:0 !important;padding:2px 0 2px 20px;border-left:4px solid #8d1d22}
.pc li::marker{content:none}
.pc-h{margin:0 0 8px !important;font-family:'Noto Serif TC',serif;font-weight:700;font-size:20px;line-height:30px;color:#1a1a1a}
.pc-d{margin:0 !important;font-size:16px;line-height:28px;color:#333333}
@media (max-width:760px){.pc{grid-template-columns:minmax(0,1fr);gap:22px}.pc li{padding-left:16px}.pc-h{font-size:18px;line-height:27px}}
</style>
