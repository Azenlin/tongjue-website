---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const cases = (await getCollection("portfolio")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="案例" description="銅爵科技顧問的實際客戶案例。">
  <section class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="text-3xl font-bold text-ink-700 mb-4">案例</h1>
    <p class="text-ink-500 mb-10 max-w-2xl">實際協助客戶解決問題的紀錄，持續更新中。</p>
    <div class="grid gap-6 md:grid-cols-2">
      {cases.map((item) => (
        <article class="rounded-lg border border-primary-100 p-6">
          <p class="text-xs text-primary-500 font-semibold mb-1">{item.data.client}</p>
          <h2 class="font-semibold text-lg text-ink-700 mb-2">{item.data.title}</h2>
          <p class="text-sm text-ink-500 leading-relaxed">{item.data.summary}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
