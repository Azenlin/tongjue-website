---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="服務項目" description="銅爵科技顧問的七項服務項目。">
  <section class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="text-3xl font-bold text-ink-700 mb-4">服務項目</h1>
    <p class="text-ink-500 mb-10 max-w-2xl">
      先診斷，再開藥。以下每項服務都從你實際遇到的問題出發，不預設答案、不推銷工具。
    </p>
    <div class="grid gap-6 md:grid-cols-2">
      {services.map((service) => (
        <a
          href={`/services/${service.id}`}
          class="block rounded-lg border border-primary-100 p-6 hover:border-primary-500 hover:shadow-sm transition"
        >
          <p class="text-xs text-primary-500 font-semibold mb-2">0{service.data.order}</p>
          <h2 class="font-semibold text-lg text-ink-700 mb-2">{service.data.title}</h2>
          <p class="text-sm text-ink-500 leading-relaxed">{service.data.summary}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
