---
/**
 * 依 src/design/pages.json 產生每一頁：網址、標題、描述都在那份設定裡，
 * 版面/樣式/程式分別讀 src/design/<Name>.body.html / .css / .logic.js。
 */
import DesignPage from '../layouts/DesignPage.astro';
import pages from '../design/pages.json';
// 暫時下架、只當版型用的頁面（例如 PillarAI 是文章頁版型，但「中小企業 AI 導入指南」本身先不上線）
import hidden from '../lib/hidden-pages.json';
import { swapSubstackButton, addSubscribeSection } from '../lib/subscribe';
import { getPosts, blogLogic, latestCards, coverCss, PIN_CSS } from '../lib/posts';
import { prerender } from '../lib/prerender';

export function getStaticPaths() {
  return Object.entries(pages).filter(([name]) => !hidden.includes(name)).map(([name, p]) => ({
    params: { path: p.route === '/' ? undefined : p.route.replace(/^\/|\/$/g, '') },
    props: { name },
  }));
}

const bodies = import.meta.glob('../design/*.body.html', { query: '?raw', import: 'default', eager: true });
const styles = import.meta.glob('../design/*.css', { query: '?raw', import: 'default', eager: true });
const logics = import.meta.glob('../design/*.logic.js', { query: '?raw', import: 'default', eager: true });

const { name } = Astro.props;
const p = pages[name as keyof typeof pages];

// 文章列表與「最新觀點」卡片換成 src/content/posts/ 的真實文章（見 src/lib/posts.ts）
let body = bodies[`../design/${name}.body.html`] as string;
let css = styles[`../design/${name}.css`] as string;
let logic = logics[`../design/${name}.logic.js`] as string;
if (name === 'Blog' || name === 'Main' || name === 'Yujen') {
  const posts = await getPosts();
  css += '\n' + coverCss(posts) + PIN_CSS;
  if (name === 'Blog') logic = blogLogic(logic, posts);
  else body = latestCards(body, posts);
}
// 個人頁的電子報區塊：Substack 連結換成站內訂閱表單
if (name === 'Yujen') body = swapSubstackButton(body);
// 首頁底部加同樣的訂閱區塊
if (name === 'Main') {
  body = addSubscribeSection(body);
  css += '\n@media (max-width:760px){.sub-title{font-size:min(28px, calc((100vw - 32px) / 11.5)) !important;letter-spacing:0 !important}}';
}
// 首頁主視覺簡介文字：改成新版寫法（在這裡處理，重新匯入設計稿也不會被蓋掉；找不到舊文字就讓 build 失敗）
if (name === 'Main') {
  const introRe = /清大化工所畢業，16 年<b([^>]*)>製造業工程師<\/b>與<b([^>]*)>政府能源顧問<\/b>經驗。銅爵是一人公司，由我率領 AI 團隊，從診斷規劃到實際落地都親自負責。/;
  if (!introRe.test(body)) throw new Error('找不到首頁主視覺簡介文字，設計稿可能改版了');
  body = body.replace(introRe, (_m, b1, b2) => `一名來自高雄的 AI 導入顧問，擁有人工智慧及淨零 ESG 等多張專業證照、16 年<b${b1}>製造業工程師</b>與<b${b2}>政府能源顧問</b>經驗；現在率領 AI agent 團隊，從診斷規劃到實際落地都親自負責。`);
}
// 服務項目頁：三張卡片的「了解服務 →」hover 底線統一（設計稿只有第一張有 svc-more，其餘補上；在這裡處理，重新匯入設計稿也不會被蓋掉）
if (name === 'Services') body = body.replace(/<span style="([^"]*)">(了解服務 →)<\/span>/g, '<span class="svc-more" style="$1">$2</span>');
// 首屏最大圖（LCP）：加 fetchpriority 並預載。在這裡處理而不改 src/design，重新匯入設計稿也不會被蓋掉
const lcpSrc = { Main: '/assets/90a8bab566ecf3cf2ffd4e3c4e53b4da.jpg', Yujen: '/assets/1ac8a65bac4f4f647a4ab1fbafbde316.jpg' }[name as string];
if (lcpSrc) body = body.replace(`<img src="${lcpSrc}"`, `<img fetchpriority="high" decoding="async" src="${lcpSrc}"`);
// 動態頁：build 時先依初始資料展開樣板，讓不跑 JS 的爬蟲也讀得到文章連結與內容（見 src/lib/prerender.ts）
const prerendered = p.dynamic ? prerender(body, logic, name) : undefined;
---
<DesignPage
  name={name}
  title={p.title}
  description={p.description}
  route={p.route}
  ogImage={'ogImage' in p ? p.ogImage : undefined}
  dynamic={p.dynamic}
  body={body}
  css={css}
  logic={logic}
  prerendered={prerendered}
  preloadImage={lcpSrc}
/>
